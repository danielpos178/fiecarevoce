{{ printf "<?xml version=\"1.0\" encoding=\"UTF-8\"?>" | safeHTML }}
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9"
        xmlns:image="http://www.google.com/schemas/sitemap-image/1.1">
{{- range .Data.Pages -}}
  {{- $p := . -}}
  {{- $skip := false -}}
  {{- if or $p.Draft $p.Sitemap.Disable (in site.Params.sitemap.excludedKinds $p.Kind) $p.Params.excludeFromSearch -}}
    {{- $skip = true -}}
  {{- end -}}
  {{- if or (eq $p.RelPermalink "/mentenanta/") (strings.Contains (lower (string $p.Params.robots)) "noindex") -}}
    {{- $skip = true -}}
  {{- end -}}
  {{- if not $skip -}}
    {{- if $p.Permalink -}}
      {{- $lastmod := $p.Lastmod -}}
      {{- if $lastmod.IsZero -}}
        {{- $lastmod = $p.PublishDate | default $p.Date | default now -}}
      {{- end -}}
      {{- $priority := "0.5" -}}
      {{- $changefreq := "monthly" -}}
      {{- if $p.IsHome -}}
        {{- $priority = "1.0" -}}
        {{- $changefreq = "daily" -}}
      {{- else if and $p.IsSection (eq $p.Type "posts") -}}
        {{- $priority = "0.9" -}}
        {{- $changefreq = "daily" -}}
      {{- else if or (eq $p.Type "categories") (eq $p.Kind "taxonomy") (eq $p.Kind "term") -}}
        {{- $priority = "0.85" -}}
        {{- $changefreq = "weekly" -}}
      {{- else if and $p.IsPage (or (eq $p.Type "posts") (eq $p.Section "posts")) -}}
        {{- $priority = "0.8" -}}
        {{- $changefreq = "weekly" -}}
      {{- else if eq $p.Type "authors" -}}
        {{- $priority = "0.75" -}}
        {{- $changefreq = "weekly" -}}
      {{- else if $p.IsPage -}}
        {{- $priority = "0.7" -}}
        {{- $changefreq = "monthly" -}}
      {{- end -}}
      {{- with $p.Params.sitemap_priority -}}
        {{- $priority = . -}}
      {{- end -}}
      {{- with $p.Params.sitemap_changefreq -}}
        {{- $changefreq = . -}}
      {{- end -}}
  <url>
    <loc>{{ $p.Permalink }}</loc>
    <lastmod>{{ safeHTML ( $lastmod.Format "2006-01-02T15:04:05-07:00" ) }}</lastmod>
    <changefreq>{{ $changefreq }}</changefreq>
    <priority>{{ $priority }}</priority>
    {{- /* Specific Article / Page Image SEO Resolution */ -}}
    {{- $pageImage := "" -}}
    {{- if $p.Params.image -}}
      {{- if or (strings.HasPrefix $p.Params.image "http://") (strings.HasPrefix $p.Params.image "https://") -}}
        {{- $pageImage = $p.Params.image -}}
      {{- else -}}
        {{- $pageImage = $p.Params.image | absURL -}}
      {{- end -}}
    {{- else if $p.IsHome -}}
      {{- $pageImage = "images/logo1000.webp" | absURL -}}
    {{- else -}}
      {{- $resources := $p.Resources.ByType "image" -}}
      {{- range slice "*featured*" "*cover*" "*thumbnail*" -}}
        {{- if not $pageImage -}}
          {{- with $resources.GetMatch . -}}
            {{- $pageImage = .RelPermalink | absURL -}}
          {{- end -}}
        {{- end -}}
      {{- end -}}
    {{- end -}}
    {{- with $pageImage -}}
    <image:image>
      <image:loc>{{ . }}</image:loc>
      {{- with $p.Title -}}
      <image:title>{{ . | plainify | htmlEscape }}</image:title>
      {{- end -}}
    </image:image>
    {{- end -}}
  </url>
    {{- end -}}
  {{- end -}}
{{- end -}}
</urlset>
